# .env.example — every tunable setting of the pipeline, with its default value.
# Global context: src/steering_explainer/config.py loads `.env` first (your overrides) and then this
# file as the fallback defaults (python-dotenv never overwrites a variable that is already set:
# https://github.com/theskumar/python-dotenv#readme). Copy to `.env` to override anything.

# ---------- local tool locations (prepended to PATH; winget installs them per-user) ----------
# MiKTeX supplies `latex` + `dvisvgm` for Manim's MathTex; Pandoc builds the PDF paper.
EXTRA_PATH=%LOCALAPPDATA%/Programs/MiKTeX/miktex/bin/x64;%LOCALAPPDATA%/Pandoc
# Keep Hugging Face downloads inside the project folder (gitignored).
HF_HOME=.cache/hf

# ---------- model + steering (ActAdd Love-Hate setup, github.com/montemac/activation_additions README) ----------
MODEL_NAME=gpt2-xl
DEVICE=cuda
# float16 halves memory so GPT-2-XL (1.5B params) fits easily in 8 GB of VRAM.
DTYPE=float16
STEER_LAYER=6
STEER_COEFF=5
PROMPT_PLUS=Love
PROMPT_MINUS=Hate
EXAMPLE_PROMPT=I hate you because

# ---------- sampling (official ActAdd scripts/basic_functionality.py: temperature=1, freq_penalty=1, top_p=0.3) ----------
TEMPERATURE=1.0
TOP_P=0.3
FREQ_PENALTY=1.0
MAX_NEW_TOKENS=40

# ---------- pre-registered study (reports/exp01_preregistration.md) ----------
ALPHAS=-5,0,2,5,10,15
RANDOM_ALPHAS=5,15
N_RANDOM=5
SEEDS=0,1,2
N_PILOT=20
N_MIN=30
N_MAX=200
PROMPT_WORDS=8
SENTIMENT_MODEL=siebert/sentiment-roberta-large-english
BOOTSTRAP_RESAMPLES=10000

# ---------- video ----------
# Microsoft Edge neural voice via the edge-tts package (https://github.com/rany2/edge-tts).
TTS_VOICE=en-US-AndrewMultilingualNeural
TTS_RATE=+0%
# Manim quality flag: l=480p15 (preview), m=720p30, h=1080p60, k=4K.
RENDER_QUALITY=h
